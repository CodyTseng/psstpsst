  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/write-file-atomic": "^4.0.3",
    "@types/yauzl": "^3.4.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "node-api-headers": "1.9.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "start": "EXPO_PUBLIC_APP_ENV=development expo start --dev-client --lan",
    "android": "EXPO_PUBLIC_APP_ENV=development expo run:android --device --no-bundler",
    "ios": "EXPO_PUBLIC_APP_ENV=development expo run:ios --device --no-bundler",
    "web": "EXPO_PUBLIC_APP_ENV=development expo start --web",
    "electron:build:main": "esbuild desktop/main.ts desktop/preload.ts desktop/database-worker.ts desktop/noise-worker.ts --bundle --platform=node --format=cjs --target=node22 --outdir=desktop/dist --external:electron --external:electron-updater --external:better-sqlite3 --external:sharp",
    "electron:build:renderer": "node scripts/build-electron-renderer.mjs",
    "electron:build:native": "node scripts/build-electron-proximity.mjs && node scripts/build-electron-notifications.mjs",
    "electron:build": "npm run electron:build:main && npm run electron:build:renderer",
    "electron:rebuild": "cd desktop && electron-builder install-app-deps",
    "electron:launch": "node scripts/launch-electron.mjs",
    "electron:dev": "EXPO_PUBLIC_APP_ENV=development npm run electron:build:native && npm run electron:build:main && npm run electron:rebuild && EXPO_PUBLIC_APP_ENV=development node scripts/dev-electron.mjs",
    "electron:package": "npm run electron:build:native && npm run electron:build && electron-builder --project desktop --config electron-builder.config.cjs",
    "electron:package:dev": "EXPO_PUBLIC_APP_ENV=development npm run electron:package",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "postinstall": "patch-package --error-on-fail",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:refresh": "node scripts/generate-licenses.mjs --refresh",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "licenses:test": "node --test scripts/licenses/*.test.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^#alloc$": "<rootDir>/node_modules/uint8arrays/dist/src/alloc.js",
      "^#compare$": "<rootDir>/node_modules/uint8arrays/dist/src/compare.js",
      "^#concat$": "<rootDir>/node_modules/uint8arrays/dist/src/concat.js",
      "^#from-string$": "<rootDir>/node_modules/uint8arrays/dist/src/from-string.js",
      "^#to-string$": "<rootDir>/node_modules/uint8arrays/dist/src/to-string.js",
      "^#util/as-uint8array$": "<rootDir>/node_modules/uint8arrays/dist/src/util/as-uint8array.js",
      "^uint8arraylist$": "<rootDir>/node_modules/uint8arraylist/dist/src/index.js",
      "^uint8arrays$": "<rootDir>/node_modules/uint8arrays/dist/src/index.js",
      "^uint8arrays/(.*)$": "<rootDir>/node_modules/uint8arrays/dist/src/$1.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@libp2p/noise|@noble/.*|@scure/.*|nostr-tools|react-navigation|@react-navigation/.*|react-native-svg|uint8arraylist|uint8arrays))"
    ]
  },
  "private": true
}
