    "expo-task-manager": "~56.0.27",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.6",
    "i18next": "^26.3.0",
    "jpeg-js": "^0.4.4",
    "lucide-react-native": "^1.38.0",
    "nostr-tools": "2.25.2",
    "pinyin-pro": "^3.28.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
