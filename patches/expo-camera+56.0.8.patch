+package expo.modules.camera.analyzers
+
+import android.graphics.Bitmap
+import expo.modules.camera.records.BarcodeType
+import expo.modules.camera.utils.BarCodeScannerResult
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import zxingcpp.BarcodeReader
+
+/** Each scanner owns its reader; no mutable decoder state crosses sessions. */
+class ZXingBarcodeScanner(formats: List<BarcodeType>, maxSymbols: Int = 255) {
+  val reader = BarcodeReader(
+    BarcodeReader.Options(
+      formats = (formats.ifEmpty { BarcodeType.entries.filter { it != BarcodeType.UNKNOWN } }).map { it.format }.toSet(),
+      tryHarder = true,
+      tryRotate = true,
+      tryInvert = true,
+      tryDownscale = true,
+      maxNumberOfSymbols = maxSymbols,
+      textMode = BarcodeReader.TextMode.PLAIN
+    )
+  )
+
+  suspend fun scan(bitmap: Bitmap): List<BarCodeScannerResult> = withContext(Dispatchers.Default) {
+    // The native reader accepts software RGBA or grayscale bitmaps; hardware bitmaps cannot be locked.
+    val software = if (bitmap.config == Bitmap.Config.ARGB_8888 || bitmap.config == Bitmap.Config.ALPHA_8) {
+      bitmap
+    } else {
+      requireNotNull(bitmap.copy(Bitmap.Config.ARGB_8888, false))
+    }
+    try {
+      reader.read(software).filter { it.error == null }.map {
+        BarCodeScannerResultSerializer.parseBarcodeScanningResult(it, software.width, software.height)
+      }
+    } finally {
+      if (software !== bitmap) software.recycle()
+    }
+  }
+}
