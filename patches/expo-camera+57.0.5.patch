+          raw = barcode.raw.toString(),
+          type = BarcodeType.mapFormatToString(barcode.type),
+          cornerPoints = cornerPoints,
+          bounds = boundingBox,
+          extra = barcode.extra
+        )
+      )
+    }
+  }
